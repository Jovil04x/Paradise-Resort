{
  "rewrites": [
    { "source": "/", "destination": "/firebase-app/index.html" }
  ],
  "headers": [
    {
      "source": "/firebase-app/(.*)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(room|images|logo|landing|assets)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, immutable" }]
    }
  ]
}
