rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /chat-images/{conversationId}/{uploaderUid}/{fileName} {
      allow read: if signedIn() &&
        (isAdmin() ||
          uploaderUid == request.auth.uid ||
          firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.customerUid == request.auth.uid);
      allow write: if signedIn() &&
        (isAdmin() || uploaderUid == request.auth.uid) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
